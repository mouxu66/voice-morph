    "external": [
      {
        "kind": "app",
        "label": "微信 PC 版",
        "doc": "docs/犯错指南.md（这个模块的坑最密集，见其中 §8.x 微信相关条目）"
      }
    ],
    "models": []
  },
  "health": { "module": "wechat_uia", "attr": "status" },
  "disable": {
    "note": "关闭后微信发送入口消失。这一环最依赖外部环境，单独成插件就是为了让「是这个能力不可用」一眼可见"
  }
}
