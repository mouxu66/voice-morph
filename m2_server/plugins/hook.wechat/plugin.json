{
  "id": "hook.wechat",
  "name": "微信发送",
  "kind": "builtin",
  "category": "hook",
  "order": 220,
  "summary": "把变声结果发进微信 PC 版（UIA 自动化 + 录音浮层绿钮判据）",
  "requires": [],
