#!/bin/sh
# pre-push：推送前全量门禁（ruff + pytest 全量 + 前端类型检查，约 90s）
#
# 为什么放在 push 而不是 commit：pre-commit 必须快（<5s），否则人会用
# --no-verify 绕过；而「全绿」这件事按铁律 2 必须在交付前确认，
# push 正是"要给别人看"的那一刻。
#
# pre-commit 的 hooks 已在 tools/check.py 里统一封装，这里直接跑同一条命令。
#
# 启用：python tools/install_hooks.py

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if [ -x ".venv/Scripts/python.exe" ]; then
    PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    PY="python"
else
    echo "[pre-push] 未找到 Python，跳过自检" >&2
    exit 0
fi

# ---------- CI 保真复刻（仅在"改依赖 / 加测试 / 改 CI 配置"时）----------
# 本机全绿 ≠ CI 绿（2026-09-13 的 Pillow/comtypes 事故，见 docs/犯错指南.md §3.9）。
# 但 --ci-fidelity 要 3 分钟，每次 push 都跑会把人逼去用 --no-verify 绕过；
# 所以只在这类"真会改变 CI 环境或覆盖率"的改动上跑。
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
need_cifid=""
if [ -z "$upstream" ]; then
    # 首次 push 本来就是"去让 CI 跑一次"的那一刻，直接复刻最划算
    need_cifid="首次 push（尚无上游分支）"
else
    changed=$(git diff --name-only "$upstream"..HEAD)
    if printf '%s\n' "$changed" | grep -qE '(^|/)requirements[^/]*\.txt$|^m2_server/tests/|^\.github/workflows/ci\.yml$'; then
        need_cifid="改动涉及依赖清单 / 测试 / CI 配置"
    fi
fi
if [ -n "$need_cifid" ]; then
    echo "[pre-push] $need_cifid → 复刻 CI 环境再跑一遍（约 3 分钟）"
    "$PY" tools/check.py --ci-fidelity
fi

exec "$PY" tools/check.py   # 末尾留注释：行尾残留的 CR 落进注释里就无害
