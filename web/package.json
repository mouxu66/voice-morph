{
  "name": "voice-morph-desktop",
  "private": true,
  "version": "0.2.3",
  "description": "变声 · 音色克隆工作台（桌面端）",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "ship": "npm run build && node ../tools/ship_frontend.cjs",
    "watch-ship": "node watch-and-ship.cjs",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@tanstack/react-query": "^5.103.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sentry/electron": "^7.19.0",
    "@sentry/react": "^10.75.0",
    "@sentry/tracing": "^7.120.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "chokidar": "^3.6.0",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "^8.4.40",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.9",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.voicemorph.desktop",
    "productName": "变声工坊",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "backend/web_dist"
      },
      {
        "from": "../m2_server",
        "to": "backend/m2_server",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/tests/**",
          "!**/data/**"
        ]
      },
      {
        "from": "../tools",
        "to": "backend/tools"
      },
      {
        "from": "../requirements.txt",
        "to": "backend/requirements.txt"
      }
    ],
    "directories": {
      "output": "release2"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico",
      "certificateFile": "../certs/black-seraph.pfx"
    },
    "nsis": {
      "artifactName": "VoiceMorph-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "变声工坊",
      "deleteAppDataOnUninstall": false
    }
  }
}
