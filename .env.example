# 变声 M2 服务环境变量示例
# 复制为 .env 并填写；VM_ 前缀，开源部署只需设这些即可，源码内不再有机器专属硬编码。
# 注意：本服务当前直接读 os.environ，需由启动脚本/终端 export 这些变量（或接入 dotenv 加载器）。

# ---------------- 路径（未设置则回退项目内默认） ----------------
VM_TTS_MODELS_DIR=
VM_MEDIA_DIR=
VM_QWEN_MODEL_DIR=
VM_QWEN_TOKENIZER_DIR=
VM_TTS_VENV_PY=
VM_RVC_ROOT=D:/RVC
VM_RVC_EXP=meituan_rat
VM_RVC_EXPORT_DIR=
VM_RVC_TEXTS_FILE=

# ---------------- 服务进程 ----------------
VM_SERVER_HOST=0.0.0.0
VM_SERVER_PORT=8000
# CORS 来源逗号分隔；留 * 维持 LAN 可用，生产收紧为具体域名
VM_CORS_ORIGINS=*
# 可选简单 Bearer Token；留空=关闭（LAN-only 默认不拦截）
VM_API_TOKEN=
