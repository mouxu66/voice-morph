# 变声 M2 服务环境变量示例
# 复制为 .env 即可：config.py 用 python-dotenv 自动加载项目根的 .env，
# 且**真实环境变量优先**（已 export 的值不会被 .env 覆盖）。
# .env 已 gitignore —— 里面通常有本机路径，别提交。
#
# 本文件与源码的关系：源码里不再有机器专属硬编码，凡"因人而异"的值都在这里。

# ---------------- 路径（未设置则回退项目内默认） ----------------
VM_TTS_MODELS_DIR=
VM_MEDIA_DIR=
VM_QWEN_MODEL_DIR=
VM_QWEN_TOKENIZER_DIR=
VM_TTS_VENV_PY=
VM_RVC_ROOT=D:/RVC
# 默认音色（RVC 实验名）。留空 = 没有默认音色，相关页面会提示「请先创建/训练音色」。
# 你刚训练的模型会自动成为默认；只有想固定某个音色时才填这里。
VM_RVC_EXP=
# 兜底参考音：某音色没有自己的参考音频时（市场下载的多半如此）用它。
# 留空 = 自动取 tts_models/ref 下的参考音；都没有时相关链路会报「参考音频不存在」。
VM_DEFAULT_REF=
VM_RVC_EXPORT_DIR=
VM_RVC_TEXTS_FILE=

# ---------------- 服务进程 ----------------
VM_SERVER_HOST=0.0.0.0
VM_SERVER_PORT=8000
# CORS 来源逗号分隔；留 * 维持 LAN 可用，生产收紧为具体域名
VM_CORS_ORIGINS=*
# 可选简单 Bearer Token；留空=关闭（LAN-only 默认不拦截）
VM_API_TOKEN=
